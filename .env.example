# Copy to .env.local and fill in. For local development run `supabase start`, then
# `supabase status -o env` prints the URL and keys.
# Production values live in a second gitignored file, .env.hosted: the same keys plus
# SUPABASE_DB_PASSWORD and DATABASE_URL_SESSION. See README → Production.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Hosted: use the transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

APP_URL=http://localhost:3000
# Any long random string, e.g. `openssl rand -hex 24`. Scheduled jobs send it as a Bearer token.
CRON_SECRET=

APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=
APIFY_MONTHLY_BUDGET_USD=5

# Optional. The TikTok Ads sync is skipped while the token is empty.
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_IDS=
